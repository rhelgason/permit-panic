# systemd user service. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/permit-panic.service ~/.config/systemd/user/
#   # optional, for a reserved ntfy topic: echo 'NTFY_TOKEN=tk_...' > ~/.config/permit-panic.env
#   systemctl --user daemon-reload && systemctl --user enable --now permit-panic
#   loginctl enable-linger $USER     # keep running after you log out
#   journalctl --user -u permit-panic -f
[Unit]
Description=Permit Panic watcher
After=network-online.target

[Service]
WorkingDirectory=%h/permit-panic
EnvironmentFile=-%h/.config/permit-panic.env
ExecStart=%h/permit-panic/.venv/bin/permit-panic watch config.toml
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
