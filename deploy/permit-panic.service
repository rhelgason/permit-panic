# Installed to /etc/systemd/system/ by deploy/install-on-server.sh (deploy/SERVER.md).
[Unit]
Description=Permit Panic: Recreation.gov permit watcher (deploy/SERVER.md)
After=network-online.target
Wants=network-online.target

[Service]
User=permit
WorkingDirectory=/home/permit/permit-panic
EnvironmentFile=/etc/permit-panic.env
ExecStart=/home/permit/permit-panic/.venv/bin/permit-panic watch config.toml
Restart=always
RestartSec=30
# Shares a 1 GB droplet with Kalshi Desk
MemoryMax=200M

[Install]
WantedBy=multi-user.target
